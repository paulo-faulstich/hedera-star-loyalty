# Hedera testnet operator credentials.
# Create a free testnet account at https://portal.hedera.com (defaults to ECDSA keys).
# Copy this file to `.env` and fill in your values.

OPERATOR_ID=0.0.XXXXXXX
OPERATOR_KEY=0xYOUR_HEX_ENCODED_ECDSA_PRIVATE_KEY
OPERATOR_KEY_TYPE=ECDSA

# Everything below is generated automatically by the scripts and appended to .env:
# MERCHANT_ID, MERCHANT_KEY, CUSTOMER_ID, CUSTOMER_KEY  (npm run create-accounts)
# TOKEN_ID                                              (npm run mint-token)
# CUSTOM_FEE_SET                                        (npm run add-fee)
# TRANSFER_TX_ID                                        (npm run transfer)
# TOPIC_ID                                              (npm run create-topic)
#
# To regenerate the token from scratch (re-runs the pipeline):
# npm run reset-token
